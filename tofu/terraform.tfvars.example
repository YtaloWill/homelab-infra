# Copy to terraform.tfvars (git-ignored) and fill in.

# Must be root@pam ticket auth, not an API token: PVE's bind-mount (mp0)
# permission check requires authuser == "root@pam" exactly, and a token's
# authuser is "root@pam!<tokenid>" — it never passes.
pve_username = "root@pam"
pve_password = "changeme"

# Node name as listed by: pvesh get /nodes
# ("central" is the datacenter/cluster name, NOT necessarily the node name)
node_name = "pve"

# Installed as root's authorized_keys in every container.
ssh_public_keys = [
  "ssh-ed25519 AAAA... you@machine",
]

# Align these with reality before the first apply (pct config 100|101|150):
# jellyfin_disk_gb = 8
# arr_disk_gb      = 12
# samba_disk_gb    = 4
