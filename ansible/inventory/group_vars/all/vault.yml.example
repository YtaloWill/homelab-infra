---
# Copy to vault.yml, set real values, then encrypt:
#   ansible-vault encrypt inventory/group_vars/all/vault.yml
# vault.yml is git-ignored; never commit it unencrypted.

# Set to the CURRENT live samba password first so migration works against the
# existing server, then rotate (the old one is written in PLAN.md => burned).
vault_samba_password: CHANGE_ME

# Only needed when gluetun_enabled: true. Keys/values go 1:1 into
# /opt/arr/gluetun.env — see https://github.com/qdm12/gluetun-wiki
# for your provider's variables. Example (wireguard, custom provider):
vault_gluetun_environment: {}
#  VPN_SERVICE_PROVIDER: custom
#  VPN_TYPE: wireguard
#  WIREGUARD_PRIVATE_KEY: xxxxxxxx
#  WIREGUARD_ADDRESSES: 10.2.0.2/32
#  WIREGUARD_PUBLIC_KEY: yyyyyyyy
#  VPN_ENDPOINT_IP: 1.2.3.4
#  VPN_ENDPOINT_PORT: "51820"

# Only needed when configarr_enabled: true (default). Get these from each
# app's web UI: Settings -> General -> Security -> API Key.
vault_configarr_environment:
  SONARR_API_KEY: CHANGE_ME
  RADARR_API_KEY: CHANGE_ME

# BookOrbit + its Postgres database (in the separate `databases` container).
# Generate: JWT_SECRET with `openssl rand -hex 32`, SETUP_BOOTSTRAP_TOKEN
# with `openssl rand -hex 16`, POSTGRES_PASSWORD with `openssl rand -hex 24`.
# POSTGRES_PASSWORD is shared: the databases role uses it to create the
# bookorbit db/user, bookorbit's own chart uses it to build DATABASE_URL.
vault_bookorbit_environment:
  JWT_SECRET: CHANGE_ME
  SETUP_BOOTSTRAP_TOKEN: CHANGE_ME
  POSTGRES_PASSWORD: CHANGE_ME
