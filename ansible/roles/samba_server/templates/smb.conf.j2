# Managed by Ansible (roles/samba_server) — do not edit on the host.
[global]
   workgroup = WORKGROUP
   server string = homelab NAS
   server role = standalone server
   security = user
   map to guest = never
   server min protocol = SMB3_00
   load printers = no
   disable spoolss = yes
   log file = /var/log/samba/log.%m
   max log size = 500

[{{ samba_share }}]
   path = {{ samba_export_path }}
   browseable = yes
   read only = no
   valid users = {{ samba_user }}
   force user = {{ samba_user }}
   create mask = 0660
   directory mask = 0770
