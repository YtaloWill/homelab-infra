# Rendered by Ansible (roles/databases) — do not edit.
# Static provisioning: no dynamic StorageClass exists anywhere in this
# fleet, so the PersistentVolume is hand-authored and bound by matching
# storageClassName (see design decision 12/13).
apiVersion: v1
kind: PersistentVolume
metadata:
  name: postgres-data-pv
spec:
  capacity:
    storage: 20Gi
  accessModes:
    - ReadWriteOnce
  persistentVolumeReclaimPolicy: Retain
  storageClassName: manual
  # databases_export_path is already the dedicated hdd-80-backed directory
  # (tofu/databases.tf's mount_point) — no extra nesting needed here.
  hostPath:
    path: {{ databases_export_path }}
    type: Directory
