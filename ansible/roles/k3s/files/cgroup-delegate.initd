#!/sbin/openrc-run
# Alpine has no systemd, so nothing delegates cgroup v2 controllers to child
# cgroups on boot. kubelet creates its own "kubepods" cgroup and needs
# cpu/cpuset/hugetlb/memory/pids enabled in the parent's subtree_control
# first, or ContainerManager fails to start and k3s crash-loops.

description="Delegate cgroup v2 controllers so kubelet can set up kubepods"

depend() {
	need cgroups
	before k3s
}

start() {
	ebegin "Delegating cgroup v2 controllers"
	echo "+cpuset +cpu +hugetlb +memory +pids" > /sys/fs/cgroup/cgroup.subtree_control
	eend $?
}
